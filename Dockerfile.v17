FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
LABEL qfbench2.interface_version="2.0"
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
COPY agent_submit_v17 ./agent_submit_v17
COPY agent_submit_v11 ./agent_submit_v11
COPY agent_submit_v8 ./agent_submit_v8
COPY agent_submit_v7 ./agent_submit_v7
COPY agent_submit ./agent_submit
COPY agent_v2/__init__.py agent_v2/indexer.py agent_v2/retriever.py ./agent_v2/
COPY V17_PROVENANCE.md ./ARTIFACT_PROVENANCE.md
ENTRYPOINT ["python", "-m", "agent_submit_v17.cli"]
CMD ["analyze", "--help"]
