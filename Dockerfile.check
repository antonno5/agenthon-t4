FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    "qfbench2-common @ git+https://github.com/Agenthon-2026/Agenthon2026-public.git@v2.4.4#subdirectory=common"
RUN git clone https://github.com/Agenthon-2026/track4-analysis-public.git /opt/track4 \
    && git -C /opt/track4 checkout 7b2bce1d80d96f5d5667d7f67bfaa945fa5d1491
ENV PYTHONPATH=/opt/track4
WORKDIR /opt/track4
ENTRYPOINT ["qfbench2-smoke"]
